{
  "id": "existing-product-next-page",
  "version": 1,
  "title": "Existing Product Next Page",
  "description": "Continue from locked feature/navigation contracts and a shared UI baseline to the next page without reopening upstream design.",
  "entry_mode": "start",
  "required_authorities": [
    "feature_contract",
    "navigation_contract",
    "baseline"
  ],
  "parallel_policy": "serial",
  "child_scope": null,
  "final_gate": "APPROVED",
  "stages": [
    {
      "evidence_stage": "baseline",
      "target_state": "BASELINE_BOUND",
      "handler": "product-design",
      "required": true
    },
    {
      "evidence_stage": "task",
      "target_state": "TASK_READY",
      "handler": "product-design",
      "required": true
    },
    {
      "evidence_stage": "continuity",
      "target_state": "CONTINUITY_READY",
      "handler": "ui-continuity",
      "required": true
    },
    {
      "evidence_stage": "candidate",
      "target_state": "CANDIDATE_READY",
      "handler": "renderer",
      "required": true
    },
    {
      "evidence_stage": "guard",
      "target_state": "GUARD_REVIEWED",
      "handler": "design-guard",
      "required": true
    },
    {
      "evidence_stage": "approval-ready",
      "target_state": "AWAITING_USER_APPROVAL",
      "handler": "design-harness",
      "required": true
    }
  ]
}
