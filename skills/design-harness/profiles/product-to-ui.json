{
  "id": "product-to-ui",
  "version": 1,
  "title": "Product to UI",
  "description": "From product intent to an approved UI candidate with behavior, navigation, task, continuity, rendering, and guard gates.",
  "entry_mode": "start",
  "required_authorities": [],
  "parallel_policy": "serial",
  "child_scope": null,
  "final_gate": "APPROVED",
  "stages": [
    {
      "evidence_stage": "baseline",
      "target_state": "BASELINE_BOUND",
      "handler": "product-design",
      "required": true
    },
    {
      "evidence_stage": "behavior",
      "target_state": "BEHAVIOR_READY",
      "handler": "feature-design",
      "required": true
    },
    {
      "evidence_stage": "navigation",
      "target_state": "NAVIGATION_READY",
      "handler": "navigation-design",
      "required": true
    },
    {
      "evidence_stage": "task",
      "target_state": "TASK_READY",
      "handler": "product-design",
      "required": true
    },
    {
      "evidence_stage": "continuity",
      "target_state": "CONTINUITY_READY",
      "handler": "ui-continuity",
      "required": true
    },
    {
      "evidence_stage": "candidate",
      "target_state": "CANDIDATE_READY",
      "handler": "renderer",
      "required": true
    },
    {
      "evidence_stage": "guard",
      "target_state": "GUARD_REVIEWED",
      "handler": "design-guard",
      "required": true
    },
    {
      "evidence_stage": "approval-ready",
      "target_state": "AWAITING_USER_APPROVAL",
      "handler": "design-harness",
      "required": true
    }
  ]
}
